# Copy this file to .env.local (never committed: *.local is in .gitignore) and fill in the values from
# Supabase → Project Settings → API (or "API Keys"):
#   VITE_SUPABASE_URL      = Project URL, e.g. https://abcdefghijkl.supabase.co
#   VITE_SUPABASE_ANON_KEY = the anon / publishable key (public by design; safe because of row level security)
# Never put the service_role / secret key here: anything starting with VITE_ is shipped to every visitor.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# legacy-spline/ only
VITE_SPLINE_SCENE_URL=
